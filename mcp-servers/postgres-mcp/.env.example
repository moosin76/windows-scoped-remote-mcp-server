# Existing PostgreSQL container is exposed on Windows host port 10020.
# From the postgres-mcp container, connect back to the Windows host via host.docker.internal.
DATABASE_URI=postgresql://postgres:postgres@host.docker.internal:10020/ether_chronicle

# MCP server host port. Container listens on 8000.
POSTGRES_MCP_PORT=10021

# unrestricted = read/write, restricted = read-only with resource limits.
POSTGRES_MCP_ACCESS_MODE=unrestricted
