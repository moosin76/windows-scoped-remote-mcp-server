# [Server]
# WSR HTTP server port. Keep the default unless another local service uses this port.
MCP_PORT=12000

# [Multi-Workspace]
# First entry is the Active Workspace. Additional workspaces can be referenced for reading/analyzing.
# Format: alias:path, alias2:path2
MCP_WORKSPACE_ROOTS=main:C:\path\to\your\project,reference:C:\path\to\reference-project
MCP_WORKSPACE_ROOT=C:\path\to\your\project

# [Authentication - ChatGPT OAuth 2.1]
# Secret token used to approve the ChatGPT connection at /authorize.
# Generate a strong random value and never commit your real value to Git.
MCP_AUTH_TOKEN=your_secure_random_token_here

# [Public MCP URL]
# Set this after creating your public HTTPS endpoint.
# The Getting Started guide explains how to connect Cloudflare Tunnel or ngrok.
MCP_PUBLIC_URL=https://mcp.yourdomain.com

# [Cloudflare Tunnel]
# Set this only when using Cloudflare Tunnel. The tunnel token is provided by Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# [HTTP / Host Security]
# Optional: comma-separated hostnames allowed to reach WSR.
# MCP_ALLOWED_HOSTS=mcp.yourdomain.com
# MCP_ENDPOINT=/mcp
# MCP_HOST=0.0.0.0

# [Shell & Browser Automation]
# Windows PowerShell ('powershell'), CMD ('cmd'), or pwsh ('pwsh').
MCP_DEFAULT_SHELL=powershell
# false = show browser window, true = run Playwright in headless/background mode.
MCP_BROWSER_HEADLESS=false
# Optional persistent Playwright browser profile directory.
# MCP_BROWSER_USER_DATA_DIR=.browser-profile

# [Godot MCP Provider]
# Godot MCP is already supported by WSR. Set true only if you have the Godot MCP ready.
MCP_GODOT_ENABLED=false
MCP_GODOT_URL=http://127.0.0.1:8000/mcp

# [Provider Scheduler]
# How often WSR checks connected/unavailable Remote MCP Providers.
MCP_PROVIDER_HEALTH_INTERVAL_MS=10000
MCP_PROVIDER_RETRY_INTERVAL_MS=5000

# [Limits - Safety Guardrails]
# Max read chunk size in bytes (default: 1MB).
MCP_MAX_FILE_CHUNK_BYTES=1048576
# Max editable file size in bytes (default: 64MB).
MCP_MAX_EDIT_FILE_BYTES=67108864
# Max shell/process output buffer in bytes (default: 1MB).
MCP_MAX_OUTPUT_BYTES=1048576
# Optional advanced process/request limits.
# MCP_MAX_REQUEST_BODY=16mb
# MCP_MAX_RETAINED_PROCESS_OUTPUT_BYTES=4194304
# MCP_PROCESS_RETENTION_MS=3600000
# MCP_MAX_PROCESSES=128

# [OAuth - Advanced]
# Normally the defaults are sufficient when MCP_PUBLIC_URL is configured.
# MCP_OAUTH_ENABLED=true
# MCP_OAUTH_ISSUER=https://mcp.yourdomain.com
# MCP_OAUTH_RESOURCE=https://mcp.yourdomain.com/mcp
# MCP_OAUTH_APPROVAL_KEY=your_secure_approval_key_here
# MCP_OAUTH_STATE_FILE=.mcp-oauth-state.json
# MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# MCP_OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
