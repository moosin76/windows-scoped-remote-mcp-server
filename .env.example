# [Server]
# WSR HTTP server port. Keep the default unless another local service uses this port.
MCP_PORT=12000

# [Multi-Workspace]
# Copy workspaces.example.json to workspaces.local.json and edit the list there.
# The first workspace in the file automatically becomes the Active Workspace.
MCP_WORKSPACE_FILE=workspaces.local.json
# Legacy single-line format is still supported when MCP_WORKSPACE_FILE is unset:
# MCP_WORKSPACE_ROOTS=main:C:\path\to\your\project,reference:C:\path\to\reference-project

# [Authentication - ChatGPT OAuth 2.1]
# Secret token used to approve the ChatGPT connection at /authorize.
# Generate a strong random value and never commit your real value to Git.
MCP_AUTH_TOKEN=your_secure_random_token_here

# [Public MCP URL]
# Base public HTTPS URL only; do NOT append /mcp here.
# ChatGPT connects to MCP_PUBLIC_URL + MCP_ENDPOINT (default: /mcp).
# Example ChatGPT MCP endpoint: https://mcp.yourdomain.com/mcp
MCP_PUBLIC_URL=https://mcp.yourdomain.com

# [Cloudflare Tunnel]
# Set this only when using Cloudflare Tunnel. The tunnel token is provided by Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# [HTTP / Host Security]
# Optional: comma-separated hostnames allowed to reach WSR.
# MCP_ALLOWED_HOSTS=mcp.yourdomain.com
# MCP_ENDPOINT=/mcp
# MCP_HOST=0.0.0.0

# [Browser Automation]
# Windows shell selection is automatic. WSR prefers Git Bash, falls back to PowerShell 7,
# and installs PowerShell 7 with winget when neither shell is available.
# false = show browser window, true = run Playwright in headless/background mode.
MCP_BROWSER_HEADLESS=false
# Optional persistent Playwright browser profile directory.
# MCP_BROWSER_USER_DATA_DIR=.browser-profile

# [Godot AI MCP Provider v4.3+]
# Godot AI v4.3 protects its HTTP endpoint with a per-launch capability token.
# WSR therefore connects through the official `godot-ai attach` stdio bridge via uvx.
# start.bat/start.sh install Astral uv automatically when uvx is missing.
# Keep these ports aligned with the Godot editor panel (HTTP 8001 / WS 8002 by default).
MCP_GODOT_ENABLED=false
MCP_GODOT_COMMAND=uvx
MCP_GODOT_VERSION=4.3.0
MCP_GODOT_HTTP_PORT=8001
MCP_GODOT_WS_PORT=8002

# [Blender MCP Provider]
# Blender MCP uses stdio for MCP itself and connects to the Blender add-on socket below.
# Start the Blender add-on MCP server first (default port 9876).
MCP_BLENDER_ENABLED=false
MCP_BLENDER_COMMAND=uvx
MCP_BLENDER_HOST=127.0.0.1
MCP_BLENDER_PORT=9876

# [Windows Computer Use MCP Provider]
# CursorTouch/Windows-MCP runs as a local stdio child process. uvx downloads/caches
# it automatically on first use, so no repository clone under mcp-servers is needed.
# The default allowlist keeps only desktop observation/UI input tools and excludes
# App/PowerShell/FileSystem/Process/Registry/Scrape to avoid overlapping WSR core tools.
MCP_WINDOWS_ENABLED=false
MCP_WINDOWS_COMMAND=uvx
MCP_WINDOWS_TOOLS=DisplayInventory,Snapshot,Screenshot,Click,Type,Scroll,Move,Shortcut,Wait,WaitFor,MultiSelect,MultiEdit,Clipboard

# [PostgreSQL MCP Provider]
# CrystalDBA postgres-mcp uses the legacy SSE transport.
# See mcp-servers/postgres-mcp/README.md for Docker setup.
MCP_POSTGRESQL_ENABLED=false
MCP_POSTGRESQL_URL=http://127.0.0.1:10021/sse

# [Game Assets Studio MCP Provider]
# GAS Desktop exposes a localhost-only Streamable HTTP endpoint on a fixed port.
# Start the GAS Desktop app before expecting this provider to be connected.
MCP_GAS_ENABLED=false
MCP_GAS_URL=http://127.0.0.1:52214/mcp

# [MCP Request Logging]
# Log one compact line per MCP tool call: HH:MM:SS - workspace - tool_name - duration_ms.
# Protocol traffic such as initialize/tools/list is not logged.
MCP_REQUEST_LOGGING=true

# [Provider Scheduler]
# How often WSR checks connected/unavailable Remote MCP Providers.
MCP_PROVIDER_HEALTH_INTERVAL_MS=10000
MCP_PROVIDER_RETRY_INTERVAL_MS=5000

# [Limits - Safety Guardrails]
# Max read chunk size in bytes (default: 4MB).
MCP_MAX_FILE_CHUNK_BYTES=4194304
# Max editable file size in bytes (default: 128MB).
MCP_MAX_EDIT_FILE_BYTES=134217728
# Max shell/process output buffer in bytes (default: 4MB).
MCP_MAX_OUTPUT_BYTES=4194304
# Optional advanced process/request/session limits.
# MCP_MAX_REQUEST_BODY=16mb
# MCP_MAX_RETAINED_PROCESS_OUTPUT_BYTES=4194304
# MCP_PROCESS_RETENTION_MS=3600000
# MCP_MAX_PROCESSES=128
# Modern ChatGPT/OpenAI MCP session cache: idle TTL 6h, maximum 16 retained sessions.
# MCP_MODERN_SESSION_RETENTION_MS=21600000
# MCP_MAX_MODERN_SESSIONS=16

# [OAuth - Advanced]
# Normally the defaults are sufficient when MCP_PUBLIC_URL is configured.
# MCP_OAUTH_ENABLED=true
# MCP_OAUTH_ISSUER=https://mcp.yourdomain.com
# MCP_OAUTH_RESOURCE=https://mcp.yourdomain.com/mcp
# MCP_OAUTH_APPROVAL_KEY=your_secure_approval_key_here
# MCP_OAUTH_STATE_FILE=.mcp-oauth-state.json
# MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# MCP_OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
